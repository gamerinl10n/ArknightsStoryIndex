{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "flask",
  "buildCommand": "python build.py",
  "functions": {
    "app.py": {
      "includeFiles": "{generated/search.sqlite,characters.json,web/**}",
      "excludeFiles": "{data/**,node_modules/**,tests/**,docs/**,.git/**,__pycache__/**}",
      "maxDuration": 60
    }
  }
}
